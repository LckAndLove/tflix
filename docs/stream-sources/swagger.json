          { "name": "number", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "subOrDub", "in": "path", "required": true, "schema": { "type": "string", "enum": ["sub", "dub"] } },
          { "name": "fallback", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/EmbedHtml" } },
        "x-upstreamUrl": "https://vidlink.pro/anime/{malId}/{number}/{subOrDub}",
