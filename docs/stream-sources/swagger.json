  "components": {
    "parameters": {
      "MediaId": { "name": "id", "in": "path", "required": true, "description": "TMDB numeric ID or, where supported, an IMDb ID beginning with tt.", "schema": { "type": "string", "pattern": "^(tt[0-9]+|[0-9]+)$" } },
      "TmdbId": { "name": "tmdb_id", "in": "path", "required": true, "description": "TMDB numeric ID.", "schema": { "type": "integer", "minimum": 1 } },
      "Season": { "name": "season", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "Episode": { "name": "episode", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "Language": { "name": "lang", "in": "query", "description": "Optional language code.", "schema": { "type": "string", "example": "en" } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "ResultsPerPage": { "name": "resultsPerPage", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "Ordering": { "name": "ordering", "in": "query", "schema": { "type": "string", "example": "views" } },
      "Direction": { "name": "direction", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
      "SearchQuery": { "name": "query", "in": "query", "schema": { "type": "string", "minLength": 3 } },
      "Year": { "name": "year", "in": "query", "schema": { "type": "integer" } },
      "Slider": { "name": "slider", "in": "query", "schema": { "oneOf": [{ "type": "boolean" }, { "type": "string", "enum": ["0", "1", "true", "yes"] }] } },
      "Featured": { "name": "featured", "in": "query", "schema": { "oneOf": [{ "type": "boolean" }, { "type": "string", "enum": ["0", "1", "true", "yes"] }] } },
      "VidSrcEmbedOptions": { "name": "embedOptions", "in": "query", "description": "Documented query options include autoplay, autonext, startAt, ds_lang, sub_url, sub_label and sub_lang. This bundled object is a documentation placeholder; send the individual query parameters to the upstream URL.", "schema": { "type": "object", "additionalProperties": true } },
      "CineSrcSeason": { "name": "s", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "CineSrcEpisode": { "name": "e", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "CineSrcOptions": { "name": "playerOptions", "in": "query", "description": "Documented options include seek, autoplay, muted, color, controls, back, autonext, autoskip, prioritize, lastserver, t, continueprompt and quality. Send them individually to the upstream URL.", "schema": { "type": "object", "additionalProperties": true } },
      "VidFastMovieOptions": { "name": "playerOptions", "in": "query", "description": "Documented options include autoPlay, title, poster, startAt, theme, server, hideServer, fullscreenButton, chromecast and sub.", "schema": { "type": "object", "additionalProperties": true } },
      "VidFastTvOptions": { "name": "playerOptions", "in": "query", "description": "Documented TV options include autoPlay, title, poster, startAt, theme, nextButton, autoNext, server, hideServer, fullscreenButton, chromecast and sub.", "schema": { "type": "object", "additionalProperties": true } },
      "VidLinkOptions": { "name": "playerOptions", "in": "query", "description": "Documented options include primaryColor, secondaryColor, iconColor, icons, player, title, poster, autoplay, nextbutton, startAt, sub_file, sub_label and fallback_url. Send them individually to the upstream URL.", "schema": { "type": "object", "additionalProperties": true } }
    },
    "responses": {
      "EmbedHtml": { "description": "HTML player document returned for iframe embedding.", "content": { "text/html": { "schema": { "type": "string" } } } },
      "JsonAny": { "description": "Provider-defined JSON response.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } },
      "VidSrcInfo": { "description": "VidSrc availability and quality metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VidSrcInfo" } } } },
      "VidSrcNotFound": { "description": "Requested title or episode is unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VidSrcNotFound" } } } }
    },
    "schemas": {
      "VidSrcInfo": { "type": "object", "properties": { "status_code": { "type": "integer" }, "type": { "type": "string", "enum": ["movie", "tv", "episode"] }, "imdb_id": { "type": ["string", "null"] }, "tmdb_id": { "type": ["string", "null"] }, "title": { "type": "string" }, "quality": { "type": "string" }, "embed_url": { "type": "string", "format": "uri" }, "embed_url_tmdb": { "type": ["string", "null"], "format": "uri" } }, "additionalProperties": true },
      "VidSrcNotFound": { "type": "object", "required": ["status_code", "error", "message"], "properties": { "status_code": { "type": "integer", "example": 404 }, "error": { "type": "string", "example": "not found" }, "message": { "type": "string" } } }
    }
  },
