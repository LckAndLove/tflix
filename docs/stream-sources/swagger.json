        "operationId": "moviesApiDiscoverViews",
        "summary": "List MoviesAPI trending content",
        "parameters": [
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["movie", "tv"] } },
          { "name": "views", "in": "query", "schema": { "type": "string", "enum": ["day", "week", "month", "total"] } },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Year" },
          { "$ref": "#/components/parameters/ResultsPerPage" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/JsonAny" } },
        "x-upstreamUrl": "https://moviesapi.to/api/discover/views",
        "x-sourceDocumentation": "https://moviesapi.to/"
      }
    },
