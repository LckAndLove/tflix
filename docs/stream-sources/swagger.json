        "operationId": "vidsrcMovieInfo",
        "summary": "Get VidSrc movie availability and quality",
        "parameters": [{ "$ref": "#/components/parameters/MediaId" }],
        "responses": { "200": { "$ref": "#/components/responses/VidSrcInfo" }, "404": { "$ref": "#/components/responses/VidSrcNotFound" } },
        "x-upstreamUrl": "https://vidsrc.sh/info/movie/{id}.json",
        "x-sourceDocumentation": "https://vidsrc.sh/vidsrc/docs/"
      }
    },
    "/vidsrc/info/tv/{id}.json": {
