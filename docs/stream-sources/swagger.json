        "responses": { "200": { "$ref": "#/components/responses/VidSrcInfo" }, "404": { "$ref": "#/components/responses/VidSrcNotFound" } },
        "x-upstreamUrl": "https://vidsrc.sh/info/tv/{id}.json",
        "x-sourceDocumentation": "https://vidsrc.sh/vidsrc/docs/"
      }
    },
    "/vidsrc/info/tv/{id}/{season}/{episode}.json": {
