          { "$ref": "#/components/parameters/VidSrcEmbedOptions" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/EmbedHtml" } },
        "x-upstreamUrl": "https://vidsrc.sh/embed/tv/{id}/{season}/{episode}",
        "x-alternateUpstreamUrl": "https://vidsrc.sh/embed/tv/{id}/{season}-{episode}",
        "x-sourceDocumentation": "https://vidsrc.sh/vidsrc/docs/"
