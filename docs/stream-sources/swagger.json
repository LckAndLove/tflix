{
  "openapi": "3.1.0",
  "info": {
    "title": "TFLIX public playback source catalog",
    "version": "2026-10-20",
    "description": "A locally captured OpenAPI catalog for the six public embed providers currently configured by TFLIX. These providers expose HTML players and, where documented, JSON catalog or metadata endpoints. The provider prefix in each path is a documentation namespace; use x-upstreamUrl for the actual request URL. Availability and provider behavior can change without notice."
  },
  "servers": [
    {
      "url": "https://{providerHost}",
      "description": "The provider host for the selected operation.",
      "variables": {
        "providerHost": {
          "default": "vixsrc.to",
          "enum": [
            "vixsrc.to",
            "moviesapi.to",
            "vidsrc.sh",
            "cinesrc.st",
            "vidfast.vc",
            "vidlink.pro"
          ]
        }
      }
    }
  ],
  "tags": [
    { "name": "VixSrc", "description": "TFLIX Rakan source (server 1)." },
    { "name": "MoviesAPI", "description": "TFLIX Bard source (server 2)." },
    { "name": "VidSrc", "description": "TFLIX Xayah source (server 3)." },
    { "name": "CineSrc", "description": "TFLIX Ekko source (server 4)." },
    { "name": "VidFast", "description": "TFLIX Naafiri source (server 5)." },
    { "name": "VidLink", "description": "TFLIX Ryze source (server 6)." }
  ],
  "paths": {
    "/vixsrc/movie/{id}": {
      "get": {
        "tags": ["VixSrc"],
        "operationId": "vixsrcEmbedMovie",
        "summary": "Embed a VixSrc movie",
        "parameters": [{ "$ref": "#/components/parameters/MediaId" }],
        "responses": { "200": { "$ref": "#/components/responses/EmbedHtml" } },
        "x-upstreamUrl": "https://vixsrc.to/movie/{id}",
        "x-sourceDocumentation": "https://vixsrc.to/"
      }
    },
    "/vixsrc/tv/{id}/{season}/{episode}": {
      "get": {
        "tags": ["VixSrc"],
        "operationId": "vixsrcEmbedTvEpisode",
        "summary": "Embed a VixSrc TV episode",
        "parameters": [
          { "$ref": "#/components/parameters/MediaId" },
          { "$ref": "#/components/parameters/Season" },
          { "$ref": "#/components/parameters/Episode" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/EmbedHtml" } },
        "x-upstreamUrl": "https://vixsrc.to/tv/{id}/{season}/{episode}",
        "x-sourceDocumentation": "https://vixsrc.to/"
      }
    },
    "/vixsrc/api/list/{type}": {
      "get": {
        "tags": ["VixSrc"],
        "operationId": "vixsrcListCatalog",
        "summary": "List VixSrc catalog entries",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["movie", "tv", "episode"] }
          },
          { "$ref": "#/components/parameters/Language" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/JsonAny" } },
        "x-upstreamUrl": "https://vixsrc.to/api/list/{type}?lang={lang}",
        "x-sourceDocumentation": "https://vixsrc.to/"
      }
    },
    "/moviesapi/movie/{id}": {
