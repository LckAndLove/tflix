        "x-sourceDocumentation": "https://moviesapi.to/"
      }
    },
    "/moviesapi/api/discover/movies": {
      "get": {
        "tags": ["MoviesAPI"],
        "operationId": "moviesApiDiscoverMovies",
        "summary": "Discover MoviesAPI movies",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/ResultsPerPage" },
          { "$ref": "#/components/parameters/Ordering" },
          { "$ref": "#/components/parameters/Direction" },
          { "$ref": "#/components/parameters/SearchQuery" },
          { "$ref": "#/components/parameters/Year" },
          { "name": "imdb_id", "in": "query", "schema": { "type": "string" } },
          { "name": "tmdbid", "in": "query", "schema": { "type": "integer" } },
          { "$ref": "#/components/parameters/Slider" },
          { "$ref": "#/components/parameters/Featured" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/JsonAny" } },
        "x-upstreamUrl": "https://moviesapi.to/api/discover/movies",
        "x-sourceDocumentation": "https://moviesapi.to/"
      }
    },
    "/moviesapi/api/discover/tv": {
      "get": {
        "tags": ["MoviesAPI"],
        "operationId": "moviesApiDiscoverTv",
