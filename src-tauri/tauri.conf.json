{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFLIX",
  "version": "1.3.0",
  "identifier": "com.nunesnetwork.tflix",
  "build": {
    "beforeDevCommand": "node scripts/prepare-ui.mjs",
    "beforeBuildCommand": "node scripts/prepare-ui.mjs",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "copyright": "Copyright © 2026 Tomas Nunes",
    "category": "Entertainment",
    "shortDescription": "TFLIX — Watch Movies & TV desktop app",
    "longDescription": "A lightweight native shell for TFLIX."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5NkU5ODMyQjkxNTZBNUYKUldSZmFoVzVNcGh1cWZaM1VvRlZDM2FWWEsxYnFSc3E3STRjaTZ6MC9XWnBBelVpdDl0cDlMY2gK",
      "endpoints": [
        "https://github.com/LckAndLove/tflix/releases/latest/download/latest.json"
      ]
    }
  }
}
