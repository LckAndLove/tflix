{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFLIX",
  "version": "1.1.2",
  "identifier": "com.nunesnetwork.tflix",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
