{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Playback windows may report validated playback events only. No updater, file or system permissions.",
  "identifier": "native-player",
  "local": false,
  "permissions": [
    "allow-native-player-event"
  ],
  "remote": {
    "urls": [
      "https://vixsrc.to/*",
      "https://moviesapi.to/*",
      "https://vidsrc.sh/*",
      "https://cinesrc.st/*",
      "https://vidfast.vc/*",
      "https://vidlink.pro/*"
    ]
  },
  "windows": [
    "playback-*"
  ]
}
