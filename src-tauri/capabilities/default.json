{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "allow-check-update",
    "allow-install-update",
    "allow-open-external",
    "allow-open-native-player",
    "allow-open-player-external",
    "allow-update-native-player",
    "allow-send-native-player",
    "allow-close-native-player"
  ]
}
