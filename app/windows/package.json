{
  "name": "tflix-app",
  "version": "1.1.1",
  "description": "TFLIX — Watch Movies & TV, as a Windows desktop app.",
  "author": "Tomas Nunes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LckAndLove/tflix.git"
  },
  "main": "main.js",
  "scripts": {
    "make-icon": "node scripts/make-icon.js",
    "start": "node scripts/make-icon.js && electron .",
    "build": "node scripts/make-icon.js && electron-builder",
    "build:win": "node scripts/make-icon.js && electron-builder --win",
    "build:mac": "node scripts/make-icon.js && electron-builder --mac",
    "build:linux": "node scripts/make-icon.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "publish": null,
    "appId": "com.nunesnetwork.tflix",
    "productName": "TFLIX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload-main.js",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "artifactName": "tflix-mac-${arch}.${version}.${ext}"
    },
    "dmg": {
      "artifactName": "tflix-mac-${arch}.${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "tflix-windows-${arch}.${version}.${ext}"
    },
    "nsis": {
      "artifactName": "tflix-windows.setup.${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TFLIX"
    },
    "portable": {
      "artifactName": "tflix-windows.portable.${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "Video",
      "artifactName": "tflix-linux-${arch}.${version}.${ext}"
    }
  }
}
